<script>
  // Mount effect, then wait for idle before injecting the widget script.
  (window.requestIdleCallback || setTimeout)(() => {
    const s = document.createElement("script");
    s.src = "/feature-tests/third-party-idle.js";
    s.async = true;
    document.head.append(s);
  });
</script>
<h1 class="text-2xl font-semibold">Third-party scripts</h1>
<p id="first-render">First render does not wait for third-party scripts.</p>
