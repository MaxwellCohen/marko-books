import { fieldClass } from "@/lib/ui"
import { buildHref, withFilters, type SearchParams } from "@/lib/url-state"
import { cn } from "@/lib/utils"

static const DEBOUNCE_MS = 220;
static const FOCUS_KEY = "book-search-focus";

export interface Input {
  searchParams: SearchParams;
}

// Keep every other filter in the submitted URL (page resets, like the reference).
<const/kept=Object.entries(input.searchParams).filter(([key, value]) => key !== "search" && key !== "page" && Boolean(value)) as [string, string][]>
<id/inputId>
<let/pending=false>
<let/timer=0>


<form action="/" aria-busy=(pending ? "true" : undefined) class="relative flex-1" data-filtering=(pending ? "" : undefined) method="get" role="search">
  <label class="sr-only" for=inputId>Search books</label>
  <span aria-hidden="true" class="text-muted pointer-events-none absolute top-1/2 left-3.5 flex size-4 -translate-y-1/2 items-center justify-center">
    <if=pending>
      <spinner class="size-4"/>
    </if>
    <else>
      <icon name="search" class="size-4"/>
    </else>
  </span>
  <for|entry| of=kept>
    <input name=entry[0] type="hidden" value=entry[1]/>
  </for>
  <input/field
    class=cn(fieldClass, "peer h-11 rounded-lg py-2 pr-10 pl-10 text-base sm:text-sm")
    id=inputId
    name="search"
    placeholder="Search books…"
    type="search"
    value=(input.searchParams.search ?? "")
    onInput(_, element) {
      clearTimeout(timer);
      const value = element.value;
      timer = window.setTimeout(() => {
        pending = true;
        try { sessionStorage.setItem(FOCUS_KEY, "1"); } catch {}
        const href = buildHref(withFilters(input.searchParams, { search: value.trim() || undefined }));
        if (location.pathname === "/") location.replace(href);
        else location.assign(href);
      }, DEBOUNCE_MS);
    }
  />
  <button
    aria-label="Clear search"
    class="text-muted hover:bg-card focus-visible:ring-accent/40 dark:hover:bg-card-dark absolute top-1/2 right-1.5 inline-flex size-8 shrink-0 -translate-y-1/2 items-center justify-center rounded-md transition-colors hover:text-black focus-visible:ring-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 peer-placeholder-shown:hidden dark:hover:text-white"
    type="button"
    onClick() {
      clearTimeout(timer);
      pending = true;
      location.assign(buildHref(withFilters(input.searchParams, { search: undefined })));
    }
  >
    <icon name="x" class="size-4"/>
  </button>
</form>

<script>
  // A search navigation reloads the document; put the caret back where the user was typing.
  try {
    if (sessionStorage.getItem(FOCUS_KEY)) {
      sessionStorage.removeItem(FOCUS_KEY);
      const el = field();
      el.focus();
      el.setSelectionRange(el.value.length, el.value.length);
    }
  } catch {}
</script>
