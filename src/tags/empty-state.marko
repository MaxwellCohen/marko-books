export interface Input {
  title: string;
  body?: string;
  content?: Marko.Body;
}

<div class="grid flex-1 place-items-center px-6 py-20 text-center">
  <div class="flex max-w-sm flex-col items-center gap-3">
    <book-mark animated class="mb-1 size-10"/>
    <p class="text-sm font-medium">${input.title}</p>
    <if=input.body>
      <p class="text-muted text-sm leading-6">${input.body}</p>
    </if>
    <if=input.content>
      <${input.content}/>
    </if>
  </div>
</div>
