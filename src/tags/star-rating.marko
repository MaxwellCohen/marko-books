import { cn } from "@/lib/utils"

export interface Input {
  class?: string;
  rating: number;
}

<const/rounded=Math.round(input.rating * 2) / 2>

<span aria-label=`Rated ${input.rating.toFixed(1)} out of 5` class=cn("inline-flex items-center gap-0.5", input.class) role="img">
  <for|index| of=[0, 1, 2, 3, 4]>
    <star-icon class=(index + 1 <= rounded || index + 0.5 === rounded ? "text-warning fill-current" : "text-divider dark:text-divider-dark fill-current")/>
  </for>
</span>
