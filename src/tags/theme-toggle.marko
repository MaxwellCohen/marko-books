import { applyThemeClass, readStoredTheme, storeTheme, type Theme } from "@/lib/theme"
import { cn } from "@/lib/utils"

export interface Input {
  variant?: "inline" | "pill";
}

static const OPTIONS: { theme: Theme; label: string; icon: string }[] = [
  { theme: "light", label: "Light mode", icon: "sun" },
  { theme: "dark", label: "Dark mode", icon: "moon" },
  { theme: "system", label: "System theme", icon: "monitor" },
];

<let/theme="system" as Theme>

<script>
  // Mount: pick up the stored choice, and follow OS changes while on "system".
  theme = readStoredTheme();
  const query = window.matchMedia("(prefers-color-scheme: dark)");
  query.addEventListener("change", () => {
    if (readStoredTheme() === "system") applyThemeClass("system");
  }, { signal: $signal });
</script>

<div
  class=(input.variant === "inline"
    ? "inline-flex items-center gap-0.5"
    : "border-divider dark:border-divider-dark inline-flex items-center rounded-full border p-0.5")
>
  <for|option| of=OPTIONS by="theme">
    <button
      aria-label=option.label
      aria-pressed=(theme === option.theme ? "true" : "false")
      class=cn(
        "rounded-full p-1.5 transition-colors",
        theme === option.theme
          ? "bg-card dark:bg-card-dark text-black dark:text-white"
          : "text-muted hover:text-black dark:hover:text-white",
      )
      type="button"
      onClick() {
        theme = option.theme;
        storeTheme(option.theme);
        applyThemeClass(option.theme);
      }
    >
      <icon name=option.icon class="size-4"/>
    </button>
  </for>
</div>
